{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "geupddong-admin-preview",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "preview.geupddong.com/admin*",
      "zone_name": "geupddong.com"
    }
  ],
  "assets": {
    "directory": "./build/admin-preview-assets",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
