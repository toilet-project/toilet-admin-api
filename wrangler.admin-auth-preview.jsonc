{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "geupddong-admin-auth-preview",
  "account_id": "1611d88218de929b3ed6e2cd7c863be5",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "preview.geupddong.com/admin-auth-review*", "zone_name": "geupddong.com"}],
  "assets": {
    "directory": "./build/admin-auth-preview",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {"enabled": false}
}
